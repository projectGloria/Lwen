{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lwen",
  "version": "1.0.0",
  "identifier": "com.lwen.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Lwen",
        "width": 1320,
        "height": 860,
        "minWidth": 780,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#1C1C1A",
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "Lwen",
    "category": "Productivity",
    "shortDescription": "Local AI chat for Ollama",
    "longDescription": "Lwen is a lightweight desktop client for chatting with models running locally through Ollama.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
